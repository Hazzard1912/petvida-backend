{
  "kind": "collectionType",
  "collectionName": "pets",
  "info": {
    "singularName": "pet",
    "pluralName": "pets",
    "displayName": "Pet",
    "description": "Mascotas disponibles para adopción"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "species": {
      "type": "enumeration",
      "enum": ["Perro", "Gato"],
      "required": true
    },
    "ageGroup": {
      "type": "string",
      "required": true
    },
    "gender": {
      "type": "enumeration",
      "enum": ["Macho", "Hembra"],
      "required": true
    },
    "size": {
      "type": "enumeration",
      "enum": ["Pequeño", "Mediano", "Grande"],
      "required": true
    },
    "isAdopted": {
      "type": "boolean",
      "default": false
    },
    "adoptedDated": {
      "type": "date"
    },
    "estadoInventario": {
      "type": "enumeration",
      "enum": ["En Adopción", "Reservado", "Adoptado", "Retirado"],
      "default": "En Adopción"
    },
    "validadoInventario": {
      "type": "boolean",
      "default": false
    },
    "notasInventario": {
      "type": "text"
    },
    "photos": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": true
    },
    "adoptionRequests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::adoption-request.adoption-request",
      "mappedBy": "pet"
    },
    "sponsorRequests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sponsor-request.sponsor-request",
      "mappedBy": "pet"
    }
  }
}
